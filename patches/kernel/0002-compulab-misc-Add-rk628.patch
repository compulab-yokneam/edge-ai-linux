+static void rk628_hdmi_bridge_detach(struct drm_bridge *bridge)
+{
+	struct rk628_hdmi *hdmi = bridge_to_hdmi(bridge);
+
+	rockchip_drm_unregister_sub_dev(&hdmi->sub_dev);
+}
