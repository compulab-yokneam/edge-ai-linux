+static void rk628_hdmirx_phy_set_clrdpt(struct rk628 *rk628, bool is_8bit)
+{
+	if (is_8bit)
+		hdmirx_phy_write(rk628, 0x03, 0x0000);
+	else
+		hdmirx_phy_write(rk628, 0x03, 0x0060);
+}
