+static void testif_test_data_write(struct rk628 *rk628,
+				   const struct rk628_dsi *dsi, u8 test_data)
+{
+	testif_testclk_deassert(rk628, dsi);
+	testif_set_data(rk628, dsi, test_data);
+	testif_testclk_assert(rk628, dsi);
+}
