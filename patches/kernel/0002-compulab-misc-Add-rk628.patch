+
+#define COMBTXPHY_BASE		0x90000
+#define REG(x)			((x) + COMBTXPHY_BASE)
+
+#define COMBTXPHY_CON0		REG(0x0000)
+#define SW_TX_IDLE_MASK		GENMASK(29, 20)
+#define SW_TX_IDLE(x)		UPDATE(x, 29, 20)
