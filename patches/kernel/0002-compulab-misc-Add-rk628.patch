+static void testif_testen_deassert(struct rk628 *rk628,
+				   const struct rk628_dsi *dsi)
+{
+	rk628_i2c_update_bits(rk628,  dsi->id ?
+			   GRF_MIPI_TX1_CON : GRF_MIPI_TX0_CON,
+			   PHY_TESTEN, 0);
+	udelay(1);
+}
