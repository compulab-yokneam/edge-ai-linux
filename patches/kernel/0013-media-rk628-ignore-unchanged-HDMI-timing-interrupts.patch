From 1ca1399ba36af6e12f26aea683d8d410f17b5c36 Mon Sep 17 00:00:00 2001
From: Igor Derzhavets <igor.derzhavets@compulab.co.il>
Date: Thu, 4 Jun 2026 21:19:42 +0300
Subject: [PATCH] media: rk628: ignore unchanged HDMI timing interrupts

---
 drivers/media/i2c/rk628/rk628_csi_v4l2.c | 40 +++++++++++++++++++++++-
 1 file changed, 39 insertions(+), 1 deletion(-)

diff --git a/drivers/media/i2c/rk628/rk628_csi_v4l2.c b/drivers/media/i2c/rk628/rk628_csi_v4l2.c
index 002b2ee0a5df..6e426f47100d 100644
--- a/drivers/media/i2c/rk628/rk628_csi_v4l2.c
+++ b/drivers/media/i2c/rk628/rk628_csi_v4l2.c
@@ -612,6 +612,33 @@ static int rk628_check_resulotion_change(struct v4l2_subdev *sd)
 	return 0;
 }
 
+static bool rk628_csi_signal_timing_unchanged(struct v4l2_subdev *sd,
+					      u32 hact, u32 vact)
+{
+	struct rk628_csi *csi = to_csi(sd);
+	struct v4l2_bt_timings *bt = &csi->src_timings.bt;
+	u32 val, htotal, vtotal;
+	u32 old_htotal, old_vtotal;
+
+	if (csi->nosignal || csi->src_timings.type != V4L2_DV_BT_656_1120)
+		return false;
+
+	hact &= 0xffff;
+	vact &= 0xffff;
+	if (!hact || !vact || hact != bt->width || vact != bt->height)
+		return false;
+
+	rk628_i2c_read(csi->rk628, HDMI_RX_MD_HT1, &val);
+	htotal = (val >> 16) & 0xffff;
+	rk628_i2c_read(csi->rk628, HDMI_RX_MD_VTL, &val);
+	vtotal = val & 0xffff;
+
+	old_htotal = bt->hfrontporch + bt->hsync + bt->width + bt->hbackporch;
+	old_vtotal = bt->vfrontporch + bt->vsync + bt->height + bt->vbackporch;
+
+	return htotal == old_htotal && vtotal == old_vtotal;
+}
+
 static void rk628_delayed_work_res_change(struct work_struct *work)
 {
 	struct delayed_work *dwork = to_delayed_work(work);
@@ -1515,6 +1542,7 @@ static int rk628_csi_format_change(struct v4l2_subdev *sd)
 		.u.src_change.changes = V4L2_EVENT_SRC_CH_RESOLUTION,
 	};
 	int ret;
+	bool changed = false;
 
 	ret = rk628_csi_get_detected_timings(sd, &timings);
 	if (ret) {
@@ -1527,9 +1555,10 @@ static int rk628_csi_format_change(struct v4l2_subdev *sd)
 		v4l2_print_dv_timings(sd->name,
 				"rk628_csi_format_change: New format: ",
 				&timings, false);
+		changed = true;
 	}
 
-	if (sd->devnode)
+	if (changed && sd->devnode)
 		v4l2_subdev_notify_event(sd, &rk628_csi_ev_fmt);
 
 	return LOCK_OK;
@@ -1825,6 +1854,15 @@ static int rk628_hdmirx_general_isr(struct v4l2_subdev *sd, u32 status, bool *ha
 		v4l2_dbg(1, debug, sd, "%s: HACT:%#x, VACT:%#x\n",
 			 __func__, hact, vact);
 
+		if (!(pdec_ints & AVI_CKS_CHG_ISTS) &&
+		    rk628_csi_signal_timing_unchanged(sd, hact, vact)) {
+			v4l2_dbg(1, debug, sd,
+				 "%s: ignore unchanged HDMI timing interrupt\n",
+				 __func__);
+			*handled = true;
+			return 0;
+		}
+
 		rk628_csi_enable_interrupts(sd, false);
 		if (csi->rk628->version < RK628F_VERSION)
 			enable_stream(sd, false);
-- 
2.34.1

