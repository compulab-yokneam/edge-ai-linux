+static bool rk628_csi_signal_timing_unchanged(struct v4l2_subdev *sd,
+					      u32 hact, u32 vact)
+{
+	struct rk628_csi *csi = to_csi(sd);
+	struct v4l2_bt_timings *bt = &csi->src_timings.bt;
+	u32 val, htotal, vtotal;
+	u32 old_htotal, old_vtotal;
+
+	if (csi->nosignal || csi->src_timings.type != V4L2_DV_BT_656_1120)
+		return false;
+
+	hact &= 0xffff;
+	vact &= 0xffff;
+	if (!hact || !vact || hact != bt->width || vact != bt->height)
+		return false;
+
+	rk628_i2c_read(csi->rk628, HDMI_RX_MD_HT1, &val);
+	htotal = (val >> 16) & 0xffff;
+	rk628_i2c_read(csi->rk628, HDMI_RX_MD_VTL, &val);
+	vtotal = val & 0xffff;
+
+	old_htotal = bt->hfrontporch + bt->hsync + bt->width + bt->hbackporch;
+	old_vtotal = bt->vfrontporch + bt->vsync + bt->height + bt->vbackporch;
+
+	return htotal == old_htotal && vtotal == old_vtotal;
+}
