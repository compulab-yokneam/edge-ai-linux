From 43e6b2491f2b9b0e8e5676eeba6040f5d144468e Mon Sep 17 00:00:00 2001
From: Igor Derzhavets <igor.derzhavets@compulab.co.il>
Date: Thu, 4 Jun 2026 21:20:17 +0300
Subject: [PATCH] media: rk628: accept Tegra UYVY mbus alias

---
 drivers/media/i2c/rk628/rk628_csi_v4l2.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/drivers/media/i2c/rk628/rk628_csi_v4l2.c b/drivers/media/i2c/rk628/rk628_csi_v4l2.c
index 6e426f47100d..8b8d84f43d9f 100644
--- a/drivers/media/i2c/rk628/rk628_csi_v4l2.c
+++ b/drivers/media/i2c/rk628/rk628_csi_v4l2.c
@@ -2179,11 +2179,13 @@ static int rk628_csi_enum_frame_sizes(struct v4l2_subdev *sd,
 				   struct v4l2_subdev_frame_size_enum *fse)
 {
 	struct rk628_csi *csi = to_csi(sd);
+	bool uyvy_1x16_alias = fse->code == MEDIA_BUS_FMT_UYVY8_1X16 &&
+			       csi->plat_data->bus_fmt == MEDIA_BUS_FMT_UYVY8_2X8;
 
 	if (fse->index >= ARRAY_SIZE(supported_modes))
 		return -EINVAL;
 
-	if (fse->code != csi->plat_data->bus_fmt)
+	if (fse->code != csi->plat_data->bus_fmt && !uyvy_1x16_alias)
 		return -EINVAL;
 
 	fse->min_width  = supported_modes[fse->index].width;
@@ -2199,10 +2201,15 @@ static int rk628_csi_enum_frame_interval(struct v4l2_subdev *sd,
 		struct v4l2_subdev_frame_interval_enum *fie)
 {
 	struct rk628_csi *csi = to_csi(sd);
+	bool uyvy_1x16_alias = fie->code == MEDIA_BUS_FMT_UYVY8_1X16 &&
+			       csi->plat_data->bus_fmt == MEDIA_BUS_FMT_UYVY8_2X8;
 
 	if (fie->index >= ARRAY_SIZE(supported_modes))
 		return -EINVAL;
 
+	if (fie->code != csi->plat_data->bus_fmt && !uyvy_1x16_alias)
+		return -EINVAL;
+
 	fie->code = csi->plat_data->bus_fmt;
 
 	fie->width = supported_modes[fie->index].width;
@@ -2329,6 +2336,10 @@ static int rk628_csi_set_fmt(struct v4l2_subdev *sd,
 		if (csi->plat_data->bus_fmt == MEDIA_BUS_FMT_UYVY8_2X8)
 			break;
 		return -EINVAL;
+	case MEDIA_BUS_FMT_UYVY8_1X16:
+		if (csi->plat_data->bus_fmt == MEDIA_BUS_FMT_UYVY8_2X8)
+			break;
+		return -EINVAL;
 	case MEDIA_BUS_FMT_RGB888_1X24:
 		if (csi->plat_data->bus_fmt == MEDIA_BUS_FMT_RGB888_1X24)
 			break;
@@ -2337,6 +2348,8 @@ static int rk628_csi_set_fmt(struct v4l2_subdev *sd,
 		return -EINVAL;
 	}
 
+	format->format.code = csi->plat_data->bus_fmt;
+
 	if (format->which == V4L2_SUBDEV_FORMAT_TRY) {
 		if (csi->plat_data->bus_fmt == MEDIA_BUS_FMT_UYVY8_2X8)
 			return 0;
-- 
2.34.1

