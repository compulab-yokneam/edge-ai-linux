From 49f44fb85a7b192296873e4217c483fcb99be404 Mon Sep 17 00:00:00 2001
From: Valentin Raevsky <valentin@compulab.co.il>
Date: Tue, 13 Jan 2026 12:55:34 +0200
Subject: [PATCH] orin: nx: Fix compatibility string

Signed-off-by: Valentin Raevsky <valentin@compulab.co.il>
---
 .../tegra234-p3768-0000+p3767-0000-nv-super-device.dts       | 5 +++++
 nv-platform/tegra234-p3768-0000+p3767-0000-nv-super-host.dts | 5 +++++
 2 files changed, 10 insertions(+)

diff --git a/nv-platform/tegra234-p3768-0000+p3767-0000-nv-super-device.dts b/nv-platform/tegra234-p3768-0000+p3767-0000-nv-super-device.dts
index 8f3159b..66dd7ca 100644
--- a/nv-platform/tegra234-p3768-0000+p3767-0000-nv-super-device.dts
+++ b/nv-platform/tegra234-p3768-0000+p3767-0000-nv-super-device.dts
@@ -6,6 +6,11 @@
 #include "tegra234-p3768-0000+p3767-0000.dts"
 #include "tegra234-p3768-0000+p3767-xxxx-nv-common.dtsi"
 
+/ {
+	compatible = "nvidia,p3768-0000+p3767-0000-super", "nvidia,p3767-0000", "nvidia,tegra234";
+	model = "NVIDIA Jetson Orin NX Engineering Reference Developer Kit Super";
+};
+
 &usb_recovery {
     mode = "device";
 };
diff --git a/nv-platform/tegra234-p3768-0000+p3767-0000-nv-super-host.dts b/nv-platform/tegra234-p3768-0000+p3767-0000-nv-super-host.dts
index 326cf50..1058c5a 100644
--- a/nv-platform/tegra234-p3768-0000+p3767-0000-nv-super-host.dts
+++ b/nv-platform/tegra234-p3768-0000+p3767-0000-nv-super-host.dts
@@ -6,6 +6,11 @@
 #include "tegra234-p3768-0000+p3767-0000.dts"
 #include "tegra234-p3768-0000+p3767-xxxx-nv-common.dtsi"
 
+/ {
+	compatible = "nvidia,p3768-0000+p3767-0000-super", "nvidia,p3767-0000", "nvidia,tegra234";
+	model = "NVIDIA Jetson Orin NX Engineering Reference Developer Kit Super";
+};
+
 &usb_recovery {
     mode = "host";
     /delete-property/ usb-role-switch;
-- 
